set(RVX_ARCH_MODULE_INVENTORY "${RVX_MODULE_INVENTORY}")
set(RVX_ARCH_POLICY_REQUIRED_FILES
    "${RVX_ARCH_MANIFEST}"
    "${RVX_ARCH_MODULE_INVENTORY}"
)

