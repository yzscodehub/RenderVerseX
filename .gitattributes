# Normalize text files in the repository so Windows Git and WSL/Linux Git
# agree on content even when the working tree uses platform line endings.
* text=auto

# Keep binary assets out of text normalization.
*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.bmp binary
*.ppm binary
*.ico binary
*.dds binary
*.ktx binary
*.ktx2 binary
*.hdr binary
*.exr binary
*.fbx binary
*.glb binary
*.gltf -diff
*.wav binary
*.mp3 binary
*.ogg binary
*.flac binary
*.zip binary
*.7z binary
*.tar binary
*.gz binary
*.dll binary
*.exe binary
*.lib binary
*.pdb binary

# Product sample assets are vendored through Git LFS. Runtime and CI consume
# these verified bytes offline; network access is reserved for the explicit
# maintainer asset-update workflow.
Samples/RenderVerseSamples/Assets/**/*.glb filter=lfs diff=lfs merge=lfs -text
Samples/RenderVerseSamples/Assets/**/*.gltf filter=lfs diff=lfs merge=lfs -text
Samples/RenderVerseSamples/Assets/**/*.bin filter=lfs diff=lfs merge=lfs -text
Samples/RenderVerseSamples/Assets/**/*.png filter=lfs diff=lfs merge=lfs -text
Samples/RenderVerseSamples/Assets/**/*.jpg filter=lfs diff=lfs merge=lfs -text
Samples/RenderVerseSamples/Assets/**/*.hdr filter=lfs diff=lfs merge=lfs -text
Samples/RenderVerseSamples/Assets/**/*.exr filter=lfs diff=lfs merge=lfs -text
Samples/RenderVerseSamples/Assets/**/*.zip filter=lfs diff=lfs merge=lfs -text
Samples/RenderVerseSamples/Assets/**/*.obj filter=lfs diff=lfs merge=lfs -text
Samples/RenderVerseSamples/Assets/**/*.mtl filter=lfs diff=lfs merge=lfs -text
Samples/RenderVerseSamples/Assets/**/*.ktx2 filter=lfs diff=lfs merge=lfs -text
