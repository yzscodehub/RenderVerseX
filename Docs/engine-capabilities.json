      "id": "core",
      "status": "integrated",
      "module": "Core",
      "runtimeComposition": "engine-required",
      "shippingSupported": true,
      "requiredEvidence": [
        { "path": "Tests/CMake/UnitTests.cmake", "contains": "CorePathValidation" }
      ]
    },
    {
